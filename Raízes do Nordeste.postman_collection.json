                  "",
                  "    pm.expect(resposta).to.have.property(\"id\");",
                  "    pm.expect(resposta).to.have.property(\"nome\");",
                  "    pm.expect(resposta).to.have.property(\"email\");",
                  "    pm.expect(resposta.perfil).to.eql(\"CLIENTE\");",
                  "});",

              ]
            }
          },
          "response": []
        },
        {
          "name": "Login Cliente",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const resposta = pm.response.json();",
                  "",
                  "pm.collectionVariables.set(\"token\", resposta.access_token);",
                  "",
                  "pm.test(\"Login realizado com sucesso\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Token JWT retornado\", function () {",
                  "    pm.expect(resposta.access_token).to.be.a(\"string\");",
                  "    pm.expect(resposta.token_type).to.eql(\"bearer\");",
                  "});",
                  "",
                  "pm.test(\"Perfil correto\", function () {",
                  "    pm.expect(resposta.perfil).to.eql(\"CLIENTE\");",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "username",
                  "value": "cliente.postman@teste.com",
                  "type": "text",
